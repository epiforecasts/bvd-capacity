# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# One model reply a document, for the external sources. Not committed, for
# the same reason data/cache/ is not: it is machine output, and
# data/external_corroboration.csv is the result that matters.
data/cache-external/
data/cache-capacity/

# One model reply a report. Not committed: it is machine output, it is bulky,
# and the datasets derived from it are committed instead. Rebuilding it costs
# one model run over the corpus.
data/cache/

# What a run leaves behind: logs, raw model stdout, model comparisons, the
# spend ledger. Nothing here is an input to anything committed, and nothing
# reads it but a person diagnosing a run. The outputs that matter are
# committed: data/ for the datasets, checks/ for the open judgements.
runs/

# Quarto: the rendered site is built by CI; the freeze is committed.
reports/_site/
reports/.quarto/
